# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# frontend dependencies
src/frontend/node_modules/
src/frontend/.pnp
src/frontend/.pnp.*
src/frontend/.yarn/*
!src/frontend/.yarn/patches
!src/frontend/.yarn/plugins
!src/frontend/.yarn/releases
!src/frontend/.yarn/versions

# frontend testing
src/frontend/coverage/

# next.js
src/frontend/.next/
src/frontend/out/

# frontend production
src/frontend/build/

# frontend typescript
src/frontend/*.tsbuildinfo
src/frontend/next-env.d.ts

# frontend debug
src/frontend/npm-debug.log*
src/frontend/yarn-debug.log*
src/frontend/yarn-error.log*
src/frontend/.pnpm-debug.log*

# backend
src/backend/.venv/
src/backend/__pycache__/
src/backend/**/__pycache__/
src/backend/.ruff_cache/
src/backend/.pytest_cache/
src/backend/*.egg-info/

# ai-grep search index
/SEARCH/
.searchignore

# misc
.DS_Store
*.pem

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# tools
.playwright-mcp/
tasks/

.playwright-cli

# llmwiki index (wiki/ is committed)
.llmwiki/

